# Copy to .env and fill in the token. .env is gitignored: never commit it.
#
#   openssl rand -hex 32
HELM_APP_TOKEN=

# Who may answer cards. The web role signs requests in as this principal, and the api records it.
HELM_OWNER=owner

# deploy/compose.yml only:
#   HELM_AUTH_HEADER       the login header your forward-auth proxy sets (default X-Forwarded-User)
#   HELM_TRUSTED_PROXIES   the CIDR the header is believed from (default 172.16.0.0/12)
#   HELM_NOTES_DIR         the folder of markdown notes to serve (default ./notes)
HELM_AUTH_HEADER=X-Forwarded-User
HELM_TRUSTED_PROXIES=172.16.0.0/12
HELM_NOTES_DIR=./notes
